# Copia este archivo a .env.local para correr la app en tu PC.
# Los valores salen de Firebase Console > Configuración del proyecto > Tus apps (app web).
# En la nube NO se usa este archivo: los valores se definen como Variables en GitHub Environments.
VITE_APP_ENV=LOCAL
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
